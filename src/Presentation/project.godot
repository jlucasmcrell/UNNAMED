; Engine configuration file.
; The Otherreach presentation shell (ARCHITECTURE.md §3): Godot renders the domain's state and turns input into
; commands. Content is read from the repository's content/ directory; nothing here is game data.

config_version=5

[application]

config/name="Otherreach"
config/description="Phase-1 playable prototype (codename UNNAMED): Ashen Hollow."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; The UI is laid out for 1920 x 1080 and scaled to the window, keeping its proportions (the Phase-1 technical audit, M-06):
; at 1366 x 768 or 1280 x 720 everything shows, smaller; a wider or taller window gets more room, not a stretched picture.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="UNNAMED.Presentation"

[rendering]

; Phase A (the visual audit's V1, measured before adoption; the lighting and environment are HollowView's): MSAA 4x with TAA for the
; alpha-tested foliage and the thin geometry, 16x anisotropic filtering for the ground at grazing angles, debanding under the overcast sky,
; soft high-quality shadow filtering and a 4096 16-bit directional shadow atlas. Chosen for RAZER's RTX 4070 Ti at 1920 x 1080 and 60 FPS.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/16_bits=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
