; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Otherreach"
config/description="Phase-1 playable prototype (codename UNNAMED): Ashen Hollow."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

InputHelper="*res://addons/input_helper/input_helper.gd"
Audio="*res://addons/quick_audio/Audio.gd"
CogitoGlobals="*res://addons/cogito/cogito_globals.gd"
CogitoSceneManager="*res://addons/cogito/SceneManagement/cogito_scene_manager.gd"
CogitoQuestManager="*res://addons/cogito/QuestSystem/cogito_quest_manager.gd"
MenuTemplateManager="*res://addons/cogito/EasyMenus/Nodes/menu_template_manager.tscn"
GameplayCueManager="*res://addons/GodotGAS/managers/gameplay_cue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="UNNAMED.Presentation"

[editor]

; Avoid the observed Windows font-import race during clean packaging.
import/use_multiple_threads=false

[editor_plugins]


[rendering]

limits/global_shader_variables/buffer_size=262144

textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
environment/ssil/quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=256
anti_aliasing/quality/use_taa=true
lights_and_shadows/positional_shadow/atlas_size=8192

[sprouty_dialogs]

text/default_typing_speed=0.05
text/display/max_characters=0
