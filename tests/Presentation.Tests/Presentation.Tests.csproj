<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The presentation's Godot-free parts (the Godot project itself cannot load outside the engine): the asset records, the coverage
       reports, the scatter rules, the voice rules, the ID-to-words half of the display-name path, a journey's words, the player's preferences, the crash log and the creator's draft and bodies, and
       the words of the away sheet, the calendar line and the Reputation sheet (they read the world's views: the World reference), compiled here as they are compiled into the game. -->
  <ItemGroup>
    <Compile Include="..\..\src\Presentation\Art\ArtRecords.cs" Link="Linked\ArtRecords.cs" />
    <Compile Include="..\..\src\Presentation\Ui\AssetWorkspace.cs" Link="Linked\AssetWorkspace.cs" />
    <Compile Include="..\..\src\Presentation\Art\ArtCoverage.cs" Link="Linked\ArtCoverage.cs" />
    <Compile Include="..\..\src\Presentation\Art\ScatterRules.cs" Link="Linked\ScatterRules.cs" />
    <Compile Include="..\..\src\Presentation\Art\EnvironmentLod.cs" Link="Linked\EnvironmentLod.cs" />
    <Compile Include="..\..\src\Presentation\Art\PlantLodBands.cs" Link="Linked\PlantLodBands.cs" />
    <Compile Include="..\..\src\Presentation\Audio\AudioCoverage.cs" Link="Linked\AudioCoverage.cs" />
    <Compile Include="..\..\src\Presentation\Audio\MusicChoice.cs" Link="Linked\MusicChoice.cs" />
    <Compile Include="..\..\src\Presentation\Audio\VoiceRules.cs" Link="Linked\VoiceRules.cs" />
    <Compile Include="..\..\src\Presentation\Ui\NameWords.cs" Link="Linked\NameWords.cs" />
    <Compile Include="..\..\src\Presentation\Ui\TravelWords.cs" Link="Linked\TravelWords.cs" />
    <Compile Include="..\..\src\Presentation\Ui\CalendarWords.cs" Link="Linked\CalendarWords.cs" />
    <Compile Include="..\..\src\Presentation\Ui\AwayWords.cs" Link="Linked\AwayWords.cs" />
    <Compile Include="..\..\src\Presentation\Ui\StandingWords.cs" Link="Linked\StandingWords.cs" />
    <Compile Include="..\..\src\Presentation\Settings\ClientPrefs.cs" Link="Linked\ClientPrefs.cs" />
    <Compile Include="..\..\src\Presentation\Diagnostics\CrashLog.cs" Link="Linked\CrashLog.cs" />
    <Compile Include="..\..\src\Presentation\Art\PlayerBodies.cs" Link="Linked\PlayerBodies.cs" />
    <Compile Include="..\..\src\Presentation\Art\IdleVariety.cs" Link="Linked\IdleVariety.cs" />
    <Compile Include="..\..\src\Presentation\Art\WornOutfit.cs" Link="Linked\WornOutfit.cs" />
    <Compile Include="..\..\src\Presentation\Ui\CreatorDraft.cs" Link="Linked\CreatorDraft.cs" />
    <Compile Include="..\..\src\Presentation\Ui\LootModel.cs" Link="Linked\LootModel.cs" />
    <Compile Include="..\..\src\Presentation\Ui\DialogueMenu.cs" Link="Linked\DialogueMenu.cs" />
  </ItemGroup>

  <!-- The player-facing screens' view models (chat, party, hiring, the Learn column, wear and load words, the context line and outline
       rules): Godot-free, mapping the world's views to what the screens say. -->
  <ItemGroup>
    <Compile Include="..\..\src\Presentation\Ui\Models\*.cs" LinkBase="Linked\Models" />
  </ItemGroup>

  <!-- The creator's draft and bodies (WP2) speak the domain's CharacterSpec; the screens' view models read the world's views. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\src\World\World.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\World\World.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
